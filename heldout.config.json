{
  "$schema": ".claude/skills/heldout-evaluator/templates/heldout.config.schema.json",
  "defaultAut": "demoqa",
  "auts": {
    "demoqa": {
      "name": "demosite",
      "baseURL": "https://demoqa.com/",
      "apiBaseURL": "https://demoqa.com/",
      "testIdAttribute": "data-testid",
      "healthcheck": [
        "/"
      ],
      "notes": "Everything AUT-specific belongs here or in .env, never inside the skill. Add one profile per application; bind a story with evaluations/<KEY>/evaluation.json.",
      "blockHosts": [
        "criteo.com",
        "criteo.net",
        "doubleclick.net",
        "google-analytics.com",
        "googlesyndication.com",
        "googletagmanager.com",
        "googletagservices.com",
        "id5-sync.com",
        "openx.net"
      ],
      "accounts": {
        "existing": [
          {
            "username": "qa-existing-mulmm7gq-1",
            "password": "${env:APP_PASSWORD_1}"
          },
          {
            "username": "qa-existing-mulmm8w3-2",
            "password": "${env:APP_PASSWORD_2}"
          },
          {
            "username": "${vault:secret/qa/demoqa#user4}",
            "password": "${vault:secret/qa/demoqa#password4}"
          },
          {
            "username": "${vault:secret/qa/demoqa#user3}",
            "password": "${vault:secret/qa/demoqa#password3}"
          }
        ],
        "perTest": 2,
        "token": {
          "method": "POST",
          "path": "/Account/v1/GenerateToken",
          "body": {
            "userName": "${username}",
            "password": "${password}"
          },
          "token": "token"
        },
        "lookup": {
          "method": "POST",
          "path": "/Account/v1/Login",
          "body": {
            "userName": "${username}",
            "password": "${password}"
          },
          "id": "userId"
        },
        "authHeader": "Authorization: Bearer ${token}",
        "signIn": {
          "path": "login",
          "done": "url:/profile",
          "steps": [
            {
              "fill": "getByRole('textbox', { name: 'UserName', exact: true })",
              "value": "${username}"
            },
            {
              "fill": "getByRole('textbox', { name: 'Password', exact: true })",
              "value": "${password}"
            },
            {
              "click": "getByRole('button', { name: 'Login', exact: true })"
            }
          ]
        },
        "reset": {
          "method": "DELETE",
          "path": "/BookStore/v1/Books?UserId=${id}"
        }
      }
    },
    "thinking-tester-contact-list": {
      "name": "Contact List App",
      "baseURL": "https://thinking-tester-contact-list.herokuapp.com/",
      "apiBaseURL": "https://thinking-tester-contact-list.herokuapp.com/",
      "testIdAttribute": "data-testid",
      "healthcheck": [
        "/"
      ],
      "notes": "Everything AUT-specific belongs here or in .env, never inside the skill. Add one profile per application; bind a story with evaluations/<KEY>/evaluation.json.",
      "accounts": {
        "password": "${env:CL_USER_PASSWORD}",
        "username": "qa-${uid}@example.com",
        "create": {
          "method": "POST",
          "path": "/users",
          "body": {
            "firstName": "QA",
            "lastName": "Heldout",
            "email": "${username}",
            "password": "${password}"
          },
          "id": "user._id",
          "token": "token"
        },
        "token": {
          "method": "POST",
          "path": "/users/login",
          "body": {
            "email": "${username}",
            "password": "${password}"
          },
          "token": "token"
        },
        "authHeader": "Authorization: Bearer ${token}",
        "delete": {
          "method": "DELETE",
          "path": "/users/me"
        },
        "signIn": {
          "path": "/",
          "done": "url:/contactList",
          "steps": [
            {
              "fill": "getByRole('textbox', { name: 'Email', exact: true })",
              "value": "${username}"
            },
            {
              "fill": "getByRole('textbox', { name: 'Password', exact: true })",
              "value": "${password}"
            },
            {
              "click": "getByRole('button', { name: 'Submit', exact: true })"
            }
          ]
        }
      }
    },
    "practicesoftwaretesting": {
      "name": "Practice Software Testing",
      "baseURL": "https://practicesoftwaretesting.com/",
      "apiBaseURL": "https://api.practicesoftwaretesting.com",
      "testIdAttribute": "data-test",
      "healthcheck": [
        "/"
      ],
      "notes": "Everything AUT-specific belongs here or in .env, never inside the skill. Add one profile per application; bind a story with evaluations/<KEY>/evaluation.json.",
      "accounts": {
        "password": "${env:TS_USER_PASSWORD}",
        "username": "hldout-${uid}@example.com",
        "create": {
          "method": "POST",
          "path": "/users/register",
          "body": {
            "first_name": "Hldout",
            "last_name": "Test",
            "email": "${username}",
            "password": "${password}"
          },
          "id": "id"
        },
        "token": {
          "method": "POST",
          "path": "/users/login",
          "body": {
            "email": "${username}",
            "password": "${password}"
          },
          "token": "access_token"
        },
        "authHeader": "Authorization: Bearer ${token}",
        "signIn": {
          "path": "auth/login",
          "done": "url:/account",
          "steps": [
            {
              "fill": "getByTestId('email')",
              "value": "${username}"
            },
            {
              "fill": "getByTestId('password')",
              "value": "${password}"
            },
            {
              "click": "getByTestId('login-submit')"
            }
          ]
        }
      }
    },
    "owasp-juice-shop": {
      "name": "OWASP Juice Shop",
      "baseURL": "http://localhost:3000/",
      "apiBaseURL": "http://localhost:3000/",
      "testIdAttribute": "data-testid",
      "healthcheck": [
        "/"
      ],
      "notes": "Everything AUT-specific belongs here or in .env, never inside the skill. Add one profile per application; bind a story with evaluations/<KEY>/evaluation.json.",
      "overlays": [
        "getByRole('button', { name: 'dismiss cookie message' })",
        "getByRole('button', { name: 'Close Welcome Banner' })"
      ],
      "accounts": {
        "before": [
          {
            "method": "GET",
            "path": "/api/SecurityQuestions",
            "save": {
              "qid": "data.0.id"
            }
          }
        ],
        "password": "${env:JS_USER_PASSWORD}",
        "username": "hldout-${uid}@example.com",
        "create": {
          "method": "POST",
          "path": "/api/Users",
          "body": {
            "email": "${username}",
            "password": "${password}",
            "passwordRepeat": "${password}",
            "securityQuestion": {
              "id": "${qid}"
            },
            "securityAnswer": "heldout"
          },
          "id": "data.id"
        },
        "token": {
          "method": "POST",
          "path": "/rest/user/login",
          "body": {
            "email": "${username}",
            "password": "${password}"
          },
          "token": "authentication.token"
        },
        "authHeader": "Authorization: Bearer ${token}",
        "signIn": {
          "path": "#/login",
          "done": "url:/search",
          "steps": [
            {
              "fill": "locator('#email')",
              "value": "${username}"
            },
            {
              "fill": "locator('#password')",
              "value": "${password}"
            },
            {
              "click": "locator('#loginButton')"
            }
          ]
        }
      }
    }
  },
  "jira": {
    "mode": "mock",
    "mockRoot": "mock-jira",
    "baseUrl": "https://your-domain.atlassian.net",
    "acceptanceCriteriaField": "customfield_10035",
    "verdictLabelPrefix": "heldout-"
  },
  "evaluationsDir": "evaluations",
  "run": {
    "retries": 1,
    "workers": 4,
    "headless": true,
    "actionTimeoutMs": 10000,
    "expectTimeoutMs": 5000,
    "testTimeoutMs": 60000
  }
}
