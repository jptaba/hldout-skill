{
  "$schema": ".github/scripts/heldout.config.schema.json",
  "defaultAut": "practicesoftwaretesting",
  "auts": {
    "practicesoftwaretesting": {
      "testIdAttribute": "data-test",
      "healthcheck": [
        "/"
      ],
      "notes": "Everything AUT-specific belongs here or in .env, never inside the skill. Add one profile per application: its stories go to output/<profile>/<KEY>/, its actions to actions/<profile>/.",
      "name": "Practice Software Testing",
      "baseURL": "https://practicesoftwaretesting.com/",
      "apiBaseURL": "https://api.practicesoftwaretesting.com",
      "accounts": {
        "password": "${env:PST_CUSTOMER_PASSWORD}",
        "username": "hldout-${uid}@example.com",
        "create": {
          "method": "POST",
          "path": "/users/register",
          "body": {
            "first_name": "Hldout",
            "last_name": "Tester",
            "email": "${username}",
            "password": "${password}",
            "dob": "1990-01-01",
            "phone": "0612345678",
            "address": {
              "street": "Test Street 1",
              "city": "Utrecht",
              "state": "Utrecht",
              "country": "NL",
              "postal_code": "3511AA"
            }
          },
          "id": "id"
        },
        "token": {
          "method": "POST",
          "path": "/users/login",
          "body": {
            "email": "${username}",
            "password": "${password}"
          },
          "token": "access_token"
        },
        "lookup": {
          "method": "GET",
          "path": "/users/me",
          "id": "id"
        },
        "authHeader": "Authorization: Bearer ${token}",
        "signIn": {
          "path": "/auth/login",
          "done": "url:/account",
          "steps": [
            {
              "fill": "getByTestId('email')",
              "value": "${username}"
            },
            {
              "fill": "getByTestId('password')",
              "value": "${password}"
            },
            {
              "click": "getByTestId('login-submit')"
            }
          ]
        }
      }
    }
  },
  "jira": {
    "mode": "mock",
    "mockRoot": "mock-jira",
    "baseUrl": "https://jira.example.com",
    "acceptanceCriteriaField": "",
    "verdictLabelPrefix": "heldout-"
  },
  "outputDir": "output",
  "actionsDir": "actions",
  "run": {
    "retries": 1,
    "workers": 4,
    "headless": true,
    "actionTimeoutMs": 10000,
    "expectTimeoutMs": 5000,
    "testTimeoutMs": 60000
  }
}
