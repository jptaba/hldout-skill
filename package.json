{
  "name": "hldout-skill",
  "version": "1.1.0",
  "private": true,
  "description": "Held-out evaluator agent skill: Jira story -> scenarios -> hardened Playwright UI/API tests -> run -> triage -> verdict -> Jira",
  "type": "module",
  "scripts": {
    "test:skill": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tests",
    "heldout": "tsx .github/scripts/heldout.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
