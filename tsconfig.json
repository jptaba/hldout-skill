{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "heldout-support/**/*.ts", "evaluations/**/*.ts", ".claude/skills/**/*.ts"],
  "exclude": ["node_modules", ".claude/skills/**/templates/**", "evaluations/**/hardening/draft-history/**", "evaluations/**/runs/**", "evaluations/**/draft/**"]
}
