{
  "vars": { "email": "hxprobe.lifecycle.a1@example.com" },
  "steps": [
    { "name": "create", "method": "POST", "path": "api/createAccount", "form": { "name": "QA Probe", "email": "${email}", "password": "${env:AE_USER_PASSWORD}", "title": "Mrs", "birth_date": "12", "birth_month": "March", "birth_year": "1991", "firstname": "Asha", "lastname": "Rao", "company": "Acme QA", "address1": "12 MG Road", "address2": "Block B", "country": "India", "zipcode": "560001", "state": "Karnataka", "city": "Bengaluru", "mobile_number": "9800000000" }, "expect": 200, "show": ["responseCode", "message"] },
    { "name": "read", "method": "GET", "path": "api/getUserDetailByEmail?email=${email}", "expect": 200, "show": ["responseCode", "user"] },
    { "name": "verify", "method": "POST", "path": "api/verifyLogin", "form": { "email": "${email}", "password": "${env:AE_USER_PASSWORD}" }, "expect": 200, "show": ["responseCode", "message"] },
    { "name": "update", "method": "PUT", "path": "api/updateAccount", "form": { "email": "${email}", "password": "${env:AE_USER_PASSWORD}", "name": "QA Probe Renamed", "city": "Mysuru" }, "expect": 200, "show": ["responseCode", "message"] },
    { "name": "read after update", "method": "GET", "path": "api/getUserDetailByEmail?email=${email}", "expect": 200, "show": ["responseCode", "user"] },
    { "name": "verifyLogin DELETE", "method": "DELETE", "path": "api/verifyLogin", "form": { "email": "${email}", "password": "${env:AE_USER_PASSWORD}" }, "expect": 200, "show": ["responseCode", "message"] },
    { "name": "delete", "method": "DELETE", "path": "api/deleteAccount", "form": { "email": "${email}", "password": "${env:AE_USER_PASSWORD}" }, "expect": 200, "show": ["responseCode", "message"] },
    { "name": "read after delete", "method": "GET", "path": "api/getUserDetailByEmail?email=${email}", "expect": 200, "show": ["responseCode", "message"] }
  ]
}
