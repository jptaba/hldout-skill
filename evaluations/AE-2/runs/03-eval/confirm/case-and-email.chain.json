{ "vars": { "e": "hxconfirm.case.c1@example.com", "E": "HXCONFIRM.CASE.C1@EXAMPLE.COM", "noat": "hxconfirm.noat.c1.example.com", "nodomain": "hxconfirm.nodomain.c1@", "nolocal": "@hxconfirm.nolocal.c1.example.com" },
  "steps": [
    { "name": "create lower-case customer", "setup": true, "method": "POST", "path": "api/createAccount", "form": { "name": "QA Confirm", "email": "${e}", "password": "${env:AE_USER_PASSWORD}", "firstname": "Asha", "lastname": "Rao", "address1": "12 MG Road", "country": "India", "zipcode": "560001", "state": "Karnataka", "city": "Bengaluru", "mobile_number": "9800000000" }, "show": ["responseCode", "message"] },
    { "name": "AC-3: create same address upper-cased", "method": "POST", "path": "api/createAccount", "form": { "name": "QA Confirm", "email": "${E}", "password": "${env:AE_USER_PASSWORD}", "firstname": "Asha", "lastname": "Rao", "address1": "12 MG Road", "country": "India", "zipcode": "560001", "state": "Karnataka", "city": "Bengaluru", "mobile_number": "9800000000" }, "show": ["responseCode", "message"] },
    { "name": "AC-3: read upper-cased address", "method": "GET", "path": "api/getUserDetailByEmail?email=${E}", "show": ["responseCode", "user.id", "user.email"] },
    { "name": "AC-3: read lower-case address", "method": "GET", "path": "api/getUserDetailByEmail?email=${e}", "show": ["responseCode", "user.id", "user.email", "user.mobile_number"] },
    { "name": "AC-5: create with no @", "method": "POST", "path": "api/createAccount", "form": { "name": "QA Confirm", "email": "${noat}", "password": "${env:AE_USER_PASSWORD}", "firstname": "Asha", "lastname": "Rao", "address1": "12 MG Road", "country": "India", "zipcode": "560001", "state": "Karnataka", "city": "Bengaluru", "mobile_number": "9800000000" }, "show": ["responseCode", "message"] },
    { "name": "AC-5: read no-@ address", "method": "GET", "path": "api/getUserDetailByEmail?email=${noat}", "show": ["responseCode", "user.email"] },
    { "name": "AC-5: create with no domain", "method": "POST", "path": "api/createAccount", "form": { "name": "QA Confirm", "email": "${nodomain}", "password": "${env:AE_USER_PASSWORD}", "firstname": "Asha", "lastname": "Rao", "address1": "12 MG Road", "country": "India", "zipcode": "560001", "state": "Karnataka", "city": "Bengaluru", "mobile_number": "9800000000" }, "show": ["responseCode", "message"] },
    { "name": "AC-5: create with no local part", "method": "POST", "path": "api/createAccount", "form": { "name": "QA Confirm", "email": "${nolocal}", "password": "${env:AE_USER_PASSWORD}", "firstname": "Asha", "lastname": "Rao", "address1": "12 MG Road", "country": "India", "zipcode": "560001", "state": "Karnataka", "city": "Bengaluru", "mobile_number": "9800000000" }, "show": ["responseCode", "message"] },
    { "name": "cleanup upper", "setup": true, "method": "DELETE", "path": "api/deleteAccount", "form": { "email": "${E}", "password": "${env:AE_USER_PASSWORD}" }, "show": ["responseCode", "message"] },
    { "name": "cleanup lower", "setup": true, "method": "DELETE", "path": "api/deleteAccount", "form": { "email": "${e}", "password": "${env:AE_USER_PASSWORD}" }, "show": ["responseCode", "message"] },
    { "name": "cleanup no-@", "setup": true, "method": "DELETE", "path": "api/deleteAccount", "form": { "email": "${noat}", "password": "${env:AE_USER_PASSWORD}" }, "show": ["responseCode", "message"] },
    { "name": "cleanup no domain", "setup": true, "method": "DELETE", "path": "api/deleteAccount", "form": { "email": "${nodomain}", "password": "${env:AE_USER_PASSWORD}" }, "show": ["responseCode", "message"] },
    { "name": "cleanup no local", "setup": true, "method": "DELETE", "path": "api/deleteAccount", "form": { "email": "${nolocal}", "password": "${env:AE_USER_PASSWORD}" }, "show": ["responseCode", "message"] }
  ] }
