{
  "vars": { "u": "qa-dq1-probe-${uid}" },
  "steps": [
    { "name": "create account", "method": "POST", "path": "Account/v1/User", "json": { "userName": "${u}", "password": "${env:DQ_USER_PASSWORD}" }, "save": { "id": "userID" }, "show": ["userID", "username", "books"], "setup": true },
    { "name": "G2 error body shape (duplicate)", "method": "POST", "path": "Account/v1/User", "json": { "userName": "${u}", "password": "${env:DQ_USER_PASSWORD}" } },
    { "name": "G6 GenerateToken body { userName, password }", "method": "POST", "path": "Account/v1/GenerateToken", "json": { "userName": "${u}", "password": "${env:DQ_USER_PASSWORD}" }, "save": { "tok": "token" }, "show": ["status", "result", "expires"] },
    { "name": "Authorized after token", "method": "POST", "path": "Account/v1/Authorized", "json": { "userName": "${u}", "password": "${env:DQ_USER_PASSWORD}" } },
    { "name": "G9 DELETE with Authorization: Bearer", "method": "DELETE", "path": "Account/v1/User/${id}", "headers": { "Authorization": "Bearer ${tok}" } },
    { "name": "GenerateToken after delete", "method": "POST", "path": "Account/v1/GenerateToken", "json": { "userName": "${u}", "password": "${env:DQ_USER_PASSWORD}" } }
  ]
}
