{
  "id": "10002",
  "key": "PB-2",
  "self": "https://your-domain.atlassian.net/rest/api/3/issue/PB-2",
  "fields": {
    "summary": "Open a new CHECKING or SAVINGS account online",
    "issuetype": {
      "name": "Story"
    },
    "status": {
      "name": "Ready for QA"
    },
    "priority": {
      "name": "High"
    },
    "labels": [],
    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "As a",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "type": "text",
              "text": " signed-in ParaBank customer"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "I want",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "type": "text",
              "text": " to open an additional checking or savings account funded from one of my existing accounts"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "so that",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "type": "text",
              "text": " I can separate my money without visiting a branch."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Background"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The \"Open New Account\" page ("
            },
            {
              "type": "text",
              "text": "openaccount.htm",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": ", Account Services menu) lets the customer pick the type of the new account and the existing account that funds the opening deposit. Partner apps use the REST service "
            },
            {
              "type": "text",
              "text": "POST /parabank/services/bank/createAccount?customerId=…&newAccountType=…&fromAccountId=…",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " for the same operation (see the OpenAPI description published by the application for the parameter encoding). Accounts are read back with "
            },
            {
              "type": "text",
              "text": "GET /customers/{customerId}/accounts",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "text",
              "text": "GET /accounts/{accountId}",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": "; transactions with "
            },
            {
              "type": "text",
              "text": "GET /accounts/{accountId}/transactions",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": ". Send "
            },
            {
              "type": "text",
              "text": "Accept: application/json",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " for JSON."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The business rules for opening an account (types, minimum opening deposit, funding) are in the attached "
            },
            {
              "type": "text",
              "text": "account-rules.csv",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "type": "text",
              "text": "; they apply to the page and to the service alike."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Test customers: the demo database is shared and reset from time to time, so each check registers its own customer first ("
            },
            {
              "type": "text",
              "text": "register.htm",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": ", unique user name, password from the environment variable "
            },
            {
              "type": "text",
              "text": "PB_USER_PASSWORD",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": "). A newly registered customer starts with one CHECKING account that has a positive balance."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Acceptance criteria"
            }
          ]
        },
        {
          "type": "orderedList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-1 (UI)",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " The Open New Account page offers exactly the account types CHECKING and SAVINGS, lists the customer's existing accounts as funding accounts, and tells the customer the minimum opening deposit from the rules (\"A minimum of $100.00 must be deposited into this account at time of opening.\")."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-2 (UI)",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Opening a SAVINGS account funded from the customer's first account shows \"Account Opened!\", \"Congratulations, your account is now open.\" and \"Your new account number:\" followed by the number as a link; the link opens the account's details page showing Account Type SAVINGS and a balance of $100.00."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-3 (UI + API)",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " After opening, the new account is listed in Accounts Overview with a balance of $100.00, and the funding account's balance is lower by $100.00 than before; "
                    },
                    {
                      "type": "text",
                      "text": "GET /customers/{customerId}/accounts",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " returns the new account with the chosen "
                    },
                    {
                      "type": "text",
                      "text": "type",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " and a "
                    },
                    {
                      "type": "text",
                      "text": "balance",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " of 100.00, and the funding account with the reduced balance."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-4 (API)",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " "
                    },
                    {
                      "type": "text",
                      "text": "POST /createAccount",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " for a CHECKING account answers 200 and returns the new account: its "
                    },
                    {
                      "type": "text",
                      "text": "id",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ", the "
                    },
                    {
                      "type": "text",
                      "text": "customerId",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ", "
                    },
                    {
                      "type": "text",
                      "text": "type",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " CHECKING and its opening "
                    },
                    {
                      "type": "text",
                      "text": "balance",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " (100.00). "
                    },
                    {
                      "type": "text",
                      "text": "GET /accounts/{id}",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " for the returned id answers 200 with the same values."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-5 (API)",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " The opening deposit is recorded as transactions per rules R8 and R9: the funding account shows a Debit of 100.00 \"Funds Transfer Sent\" and the new account a Credit of 100.00 \"Funds Transfer Received\"."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-6 (UI + API)",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Opening an account follows the funding rules in account-rules.csv on the page and through the service."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Notes"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Loan accounts are opened through \"Request Loan\" and are not part of this story."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Closing accounts is not available yet."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "attachment": [
      {
        "id": "20020",
        "filename": "account-rules.csv",
