          "body": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Clarification after refinement with the catalogue team — this replaces scenario AC-4 as written:"
                  }
                ]
              },
              {
                "type": "bulletList",
                "content": [
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "Search matches the product "
                          },
                          {
                            "type": "text",
                            "text": "name or its category name",
                            "marks": [
                              {
                                "type": "strong"
                              }
                            ]
                          },
                          {
                            "type": "text",
                            "text": " (the category under Women / Men / Kids, e.g. \"Dress\", \"Tops\", \"Tops & Shirts\", \"Tshirts\"). So searching \"dress\" must return every product whose name contains \"dress\" "
                          },
                          {
                            "type": "text",
                            "text": "plus",
                            "marks": [
                              {
                                "type": "strong"
                              }
                            ]
                          },
                          {
                            "type": "text",
                            "text": " every product in a \"Dress\" category, even if the word is not in its name — e.g. \"Sleeves Top and Short - Blue & Pink\" (Kids > Dress) belongs in the \"dress\" results. Nothing else should come back."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "The "
                          },
                          {
                            "type": "text",
                            "text": "brand",
                            "marks": [
                              {
                                "type": "strong"
                              }
                            ]
                          },
                          {
                            "type": "text",
                            "text": " is not a search field: searching \"Polo\" only finds products with \"Polo\" in the name or category. Browsing by brand is AE-3."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "Matching is a \"contains\" match, case-insensitive, as in AC-3."
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
