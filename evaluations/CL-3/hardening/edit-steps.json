[
 {
  "do": "fill",
  "target": "getByRole('textbox', { name: 'Email', exact: true })",
  "value": "${var:user}"
 },
 {
  "do": "fill",
  "target": "getByRole('textbox', { name: 'Password', exact: true })",
  "value": "${env:CL_USER_PASSWORD}"
 },
 {
  "do": "click",
  "target": "getByRole('button', { name: 'Submit', exact: true })"
 },
 {
  "do": "wait",
  "url": "url:/contactList"
 },
 {
  "do": "click",
  "target": "getByRole('row').filter({ hasText: 'Jane Doe' }).first()"
 },
 {
  "do": "wait",
  "url": "url:/contactDetails"
 },
 {
  "do": "click",
  "target": "getByRole('button', { name: 'Edit Contact' })"
 },
 {
  "do": "wait",
  "url": "url:/editContact"
 }
]