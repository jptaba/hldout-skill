    { "name": "balance of B before", "method": "GET", "path": "accounts/${B}", "show": ["balance"], "setup": true },
    { "name": "transfer amount 0", "method": "POST", "path": "transfer?fromAccountId=${A}&toAccountId=${B}&amount=0" },
    { "name": "balance of A after 0", "method": "GET", "path": "accounts/${A}", "show": ["balance"] },
    { "name": "balance of B after 0", "method": "GET", "path": "accounts/${B}", "show": ["balance"] },
    { "name": "transfer amount -10.00", "method": "POST", "path": "transfer?fromAccountId=${A}&toAccountId=${B}&amount=-10.00" },
    { "name": "balance of A after -10.00", "method": "GET", "path": "accounts/${A}", "show": ["balance"] },
    { "name": "balance of B after -10.00", "method": "GET", "path": "accounts/${B}", "show": ["balance"] }
  ] }
