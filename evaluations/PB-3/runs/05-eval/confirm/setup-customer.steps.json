[
 {
  "do": "goto",
  "url": "register.htm"
 },
 {
  "do": "fill",
  "target": "locator('[id=\"customer.firstName\"]')",
  "value": "Heldout"
 },
 {
  "do": "fill",
  "target": "locator('[id=\"customer.lastName\"]')",
  "value": "Tester"
 },
 {
  "do": "fill",
  "target": "locator('[id=\"customer.address.street\"]')",
  "value": "1 Test Street"
 },
 {
  "do": "fill",
  "target": "locator('[id=\"customer.address.city\"]')",
  "value": "Testville"
 },
 {
  "do": "fill",
  "target": "locator('[id=\"customer.address.state\"]')",
  "value": "CA"
 },
 {
  "do": "fill",
  "target": "locator('[id=\"customer.address.zipCode\"]')",
  "value": "90210"
 },
 {
  "do": "fill",
  "target": "locator('[id=\"customer.phoneNumber\"]')",
  "value": "5550100"
 },
 {
  "do": "fill",
  "target": "locator('[id=\"customer.ssn\"]')",
  "value": "123-45-6789"
 },
 {
  "do": "fill",
  "target": "locator('[id=\"customer.username\"]')",
  "value": "pb3c514529"
 },
 {
  "do": "fill",
  "target": "locator('[id=\"customer.password\"]')",
  "value": "${env:PB_USER_PASSWORD}"
 },
 {
  "do": "fill",
  "target": "locator('#repeatedPassword')",
  "value": "${env:PB_USER_PASSWORD}"
 },
 {
  "do": "click",
  "target": "getByRole('button', { name: 'Register', exact: true })"
 },
 {
  "do": "wait",
  "target": "getByText('Your account was created successfully')"
 },
 {
  "do": "goto",
  "url": "openaccount.htm"
 },
 {
  "do": "wait",
  "target": "locator('#fromAccountId:has(option)')"
 },
 {
  "do": "click",
  "target": "getByRole('button', { name: 'Open New Account' })"
 },
 {
  "do": "wait",
  "target": "locator('#newAccountId')"
 },
 {
  "do": "goto",
  "url": "overview.htm"
 },
 {
  "do": "wait",
  "target": "locator('#accountTable a')"
 }
]