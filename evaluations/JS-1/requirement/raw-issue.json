{
  "id": "10001",
  "key": "JS-1",
  "self": "https://your-domain.atlassian.net/rest/api/3/issue/JS-1",
  "fields": {
    "summary": "Product search and product details",
    "issuetype": {
      "name": "Story"
    },
    "status": {
      "name": "Ready for QA"
    },
    "priority": {
      "name": "High"
    },
    "labels": [],
    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Context"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Customers find juices by typing a term into the top-bar search of the shop (an Angular single-page app)."
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "The search view lives at the hash route "
            },
            {
              "type": "text",
              "text": "/#/search?q=<term>",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " and is backed by the REST search endpoint on"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "the same origin. Product detail information includes customer reviews. This story covers the search results"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "list, the search REST contract, how the field handles unusual input, and the review listing for a product."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Notes for whoever verifies this:"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The app shows a welcome banner and a cookie notice on first visit; dismiss them before reading the page."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Prices are rendered with a currency placeholder glyph (e.g. "
                    },
                    {
                      "type": "text",
                      "text": "1.99¤",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ")."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "No login is required for search or for reading reviews."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Acceptance criteria"
            }
          ]
        },
        {
          "type": "orderedList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "(UI) Results list.",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Navigating to "
                    },
                    {
                      "type": "text",
                      "text": "/#/search?q=apple",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " shows the matching products as a grid of cards."
                    },
                    {
                      "type": "text",
                      "text": " "
                    },
                    {
                      "type": "text",
                      "text": "Each card shows the product name, its price, and an "
                    },
                    {
                      "type": "text",
                      "text": "Add to Basket",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " button. The results header reads"
                    },
                    {
                      "type": "text",
                      "text": " "
                    },
                    {
                      "type": "text",
                      "text": "Search Results - apple",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " (the header echoes the exact term that was searched)."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "orderedList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "(API) Search contract.",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " "
                    },
                    {
                      "type": "text",
                      "text": "GET /rest/products/search?q=<term>",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " returns HTTP 200 with a JSON body of the"
                    },
                    {
                      "type": "text",
                      "text": " "
                    },
                    {
                      "type": "text",
                      "text": "shape "
                    },
                    {
                      "type": "text",
                      "text": "{\"status\":\"success\",\"data\":[ ... ]}",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ". Every product object in "
                    },
                    {
                      "type": "text",
                      "text": "data",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " matches "
                    },
                    {
                      "type": "text",
                      "text": "<term>",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " in its"
                    },
                    {
                      "type": "text",
                      "text": " "
                    },
                    {
                      "type": "text",
                      "text": "name or its description",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ", case-insensitively. For a term that matches nothing, "
                    },
                    {
                      "type": "text",
                      "text": "data",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " is an empty array"
                    },
                    {
                      "type": "text",
                      "text": " "
                    },
                    {
                      "type": "text",
                      "text": "(still HTTP 200, still "
                    },
                    {
                      "type": "text",
                      "text": "\"status\":\"success\"",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ")."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "orderedList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "(End-to-end) UI is backed by the search API.",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " For the same term, the set of product names displayed on"
                    },
                    {
                      "type": "text",
                      "text": " "
                    },
                    {
                      "type": "text",
                      "text": "the "
                    },
                    {
                      "type": "text",
                      "text": "/#/search",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " results page equals the set of product names returned by "
                    },
                    {
                      "type": "text",
                      "text": "GET /rest/products/search?q=<term>",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "orderedList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "(UI) Empty state.",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " See the attached mock-up "
                    },
                    {
                      "type": "text",
                      "text": "search-empty-state.png",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ". When a search returns no matching"
                    },
                    {
                      "type": "text",
                      "text": " "
                    },
                    {
                      "type": "text",
                      "text": "products, the results view shows the header "
                    },
                    {
                      "type": "text",
                      "text": "Search Results - <term>",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ", a "
                    },
                    {
                      "type": "text",
                      "text": "No results found",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " title, the"
                    },
                    {
                      "type": "text",
                      "text": " "
                    },
                    {
                      "type": "text",
                      "text": "helper line "
                    },
                    {
                      "type": "text",
                      "text": "Try adjusting your search to find what you're looking for.",
                      "marks": [
                        {
                          "type": "em"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ", and a result count of "
                    },
                    {
                      "type": "text",
                      "text": "0 of 0",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "orderedList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "(Security) Special characters are treated as data, not code.",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " The search term is user input and must be"
                    },
                    {
                      "type": "text",
                      "text": " "
                    },
                    {
                      "type": "text",
                      "text": "handled as literal text. When the term contains characters that are significant in SQL or markup — for"
                    },
                    {
                      "type": "text",
                      "text": " "
                    },
                    {
                      "type": "text",
                      "text": "example a single apostrophe ("
                    },
                    {
                      "type": "text",
                      "text": "'",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "), or an SQL-like fragment — the search endpoint must still return a normal"
                    },
                    {
                      "type": "text",
                      "text": " "
                    },
                    {
                      "type": "text",
                      "text": "HTTP 200 success envelope (with an empty "
                    },
                    {
                      "type": "text",
                      "text": "data",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " array when nothing matches). It must never return a"
                    },
                    {
                      "type": "text",
                      "text": " "
                    },
                    {
                      "type": "text",
                      "text": "server-side error status or leak a database engine / query message to the client."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "orderedList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "(API) Review listing.",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " "
                    },
                    {
                      "type": "text",
                      "text": "GET /rest/products/{id}/reviews",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " returns HTTP 200 with a body of the shape"
                    },
                    {
                      "type": "text",
                      "text": " "
                    },
                    {
                      "type": "text",
                      "text": "{\"status\":\"success\",\"data\":[ ... ]}",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ". Each review object carries at least a "
                    },
                    {
                      "type": "text",
                      "text": "message",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " string and an"
                    },
                    {
                      "type": "text",
                      "text": " "
                    },
                    {
                      "type": "text",
                      "text": "author",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ". For product "
                    },
                    {
                      "type": "text",
                      "text": "1",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " the listing is non-empty."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Out of scope"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Writing or liking reviews; search autocomplete; sorting and the items-per-page control."
            }
          ]
        }
      ]
    },
    "attachment": [
      {
        "id": "20010",
        "filename": "search-empty-state.png",
