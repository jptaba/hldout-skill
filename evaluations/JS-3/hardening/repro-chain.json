{
  "steps": [
    { "name": "security question", "method": "GET", "path": "api/SecurityQuestions", "save": { "qid": "data.0.id" }, "expect": 200, "setup": true },
    { "name": "sign up A", "method": "POST", "path": "api/Users", "json": { "email": "hldout-a-${uid}@example.com", "password": "${env:JS_USER_PASSWORD}", "passwordRepeat": "${env:JS_USER_PASSWORD}", "securityQuestion": { "id": "${qid}" }, "securityAnswer": "hldout" }, "expect": 201, "setup": true },
    { "name": "sign in A", "method": "POST", "path": "rest/user/login", "json": { "email": "hldout-a-${uid}@example.com", "password": "${env:JS_USER_PASSWORD}" }, "save": { "ta": "authentication.token" }, "expect": 200, "setup": true },
    { "name": "sign up B", "method": "POST", "path": "api/Users", "json": { "email": "hldout-b-${uid}@example.com", "password": "${env:JS_USER_PASSWORD}", "passwordRepeat": "${env:JS_USER_PASSWORD}", "securityQuestion": { "id": "${qid}" }, "securityAnswer": "hldout" }, "expect": 201, "setup": true },
    { "name": "sign in B", "method": "POST", "path": "rest/user/login", "json": { "email": "hldout-b-${uid}@example.com", "password": "${env:JS_USER_PASSWORD}" }, "save": { "tb": "authentication.token" }, "expect": 200, "setup": true },

    { "name": "AC-4: PUT a review WITHOUT a token (401 expected)", "method": "PUT", "path": "rest/products/1/reviews", "json": { "message": "hldout anon ${uid}", "author": "hldout-a-${uid}@example.com" }, "expect": 401 },
    { "name": "AC-6: A writes a review whose author names someone else", "method": "PUT", "path": "rest/products/1/reviews", "headers": { "Authorization": "Bearer ${ta}" }, "json": { "message": "hldout forged ${uid}", "author": "someone-else-${uid}@example.com" }, "expect": 201 },
    { "name": "A writes a review (for AC-5 and AC-8)", "method": "PUT", "path": "rest/products/1/reviews", "headers": { "Authorization": "Bearer ${ta}" }, "json": { "message": "hldout a ${uid}", "author": "hldout-a-${uid}@example.com" }, "expect": 201, "setup": true },
    { "name": "list the reviews (find A's review id: the last one)", "method": "GET", "path": "rest/products/1/reviews", "save": { "rid": "data.-1._id" }, "expect": 200, "show": ["data.length"] },
    { "name": "AC-5: B edits A's review (403 expected)", "method": "PATCH", "path": "rest/products/reviews", "headers": { "Authorization": "Bearer ${tb}" }, "json": { "id": "${rid}", "message": "hldout edited by B ${uid}" }, "expect": 403, "show": ["modified", "updated.0.message", "updated.0.author"] },
    { "name": "AC-8: B sends three likes for A's review at once", "method": "POST", "path": "rest/products/reviews", "headers": { "Authorization": "Bearer ${tb}" }, "json": { "id": "${rid}" }, "parallel": 3 },
    { "name": "read back: the anonymous review (AC-4), the forged author (AC-6), the likes counted (AC-8)", "method": "GET", "path": "rest/products/1/reviews", "expect": 200, "show": ["data.-3.message", "data.-3.author", "data.-2.message", "data.-2.author", "data.-1.likesCount", "data.-1.likedBy"] }
  ]
}
