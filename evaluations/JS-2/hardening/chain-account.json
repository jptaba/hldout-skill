{ "steps": [
  { "name": "security questions", "method": "GET", "path": "api/SecurityQuestions", "save": { "qid": "data.0.id" }, "expect": 200, "show": ["data.0.id", "data.0.question", "data.length"] },
  { "name": "register", "method": "POST", "path": "api/Users", "json": { "email": "hldout-${uid}@example.com", "password": "${env:JS_USER_PASSWORD}", "passwordRepeat": "${env:JS_USER_PASSWORD}", "securityQuestion": { "id": "${qid}" }, "securityAnswer": "heldout" }, "save": { "id": "data.id" }, "expect": 201, "show": ["status", "data.id", "data.email", "data.role"] },
  { "name": "log in", "method": "POST", "path": "rest/user/login", "json": { "email": "hldout-${uid}@example.com", "password": "${env:JS_USER_PASSWORD}" }, "save": { "token": "authentication.token", "bid": "authentication.bid" }, "expect": 200, "show": ["authentication.token|jwt", "authentication.bid", "authentication.umail"] },
  { "name": "who am I", "method": "GET", "path": "rest/user/whoami", "headers": { "Authorization": "Bearer ${token}" }, "show": ["user.id", "user.email"] },
  { "name": "a product", "method": "GET", "path": "api/Products", "save": { "pid": "data.0.id" }, "expect": 200, "show": ["data.0.id", "data.0.name"] },
  { "name": "add to basket", "method": "POST", "path": "api/BasketItems", "headers": { "Authorization": "Bearer ${token}" }, "json": { "BasketId": "${bid}", "ProductId": "${pid}", "quantity": 2 }, "save": { "item": "data.id" }, "show": ["status", "data.id", "data.quantity"] },
  { "name": "read own basket", "method": "GET", "path": "rest/basket/${bid}", "headers": { "Authorization": "Bearer ${token}" }, "expect": 200, "show": ["data.id", "data.UserId", "data.Products.length"] },
  { "name": "remove basket item", "method": "DELETE", "path": "api/BasketItems/${item}", "headers": { "Authorization": "Bearer ${token}" }, "show": ["status"] },
  { "name": "delete the user (permission?)", "method": "DELETE", "path": "api/Users/${id}", "headers": { "Authorization": "Bearer ${token}" } }
] }
