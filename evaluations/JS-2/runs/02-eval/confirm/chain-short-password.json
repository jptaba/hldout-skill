{ "steps": [
  { "name": "security questions", "method": "GET", "path": "api/SecurityQuestions", "save": { "qid": "data.0.id" }, "expect": 200, "setup": true },
  { "name": "register with a 4-character password", "method": "POST", "path": "api/Users", "json": { "email": "hldout-${uid}-a@example.com", "password": "abcd", "passwordRepeat": "abcd", "securityQuestion": { "id": "${qid}" }, "securityAnswer": "hldout" }, "expect": 400, "show": ["status", "data.id", "data.email"] },
  { "name": "log in with it (the customer exists?)", "method": "POST", "path": "rest/user/login", "json": { "email": "hldout-${uid}-a@example.com", "password": "abcd" }, "show": ["authentication.bid"] },
  { "name": "register with a 3-character password", "method": "POST", "path": "api/Users", "json": { "email": "hldout-${uid}-b@example.com", "password": "abc", "passwordRepeat": "abc", "securityQuestion": { "id": "${qid}" }, "securityAnswer": "hldout" }, "expect": 400, "show": ["status", "data.id"] }
] }
