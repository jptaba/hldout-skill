{
  "id": "10004",
  "key": "TOOL-4",
  "self": "https://your-domain.atlassian.net/rest/api/3/issue/TOOL-4",
  "fields": {
    "summary": "Favourites for signed-in customers",
    "issuetype": {
      "name": "Story"
    },
    "status": {
      "name": "Ready for QA"
    },
    "priority": {
      "name": "High"
    },
    "labels": [],
    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Signed-in customers can keep a personal list of favourite products, from the product page (web shop) and through the API (mobile app)."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Technical notes:",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "type": "text",
              "text": " endpoints "
            },
            {
              "type": "text",
              "text": "POST /favorites",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " (body "
            },
            {
              "type": "text",
              "text": "{\"product_id\"}",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": "), "
            },
            {
              "type": "text",
              "text": "GET /favorites",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "text",
              "text": "DELETE /favorites/{favoriteId}",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": "; all require "
            },
            {
              "type": "text",
              "text": "Authorization: Bearer <token>",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " from "
            },
            {
              "type": "text",
              "text": "POST /users/login",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": ". Duplicate favourites are rejected with 422."
            }
          ]
        }
      ]
    },
    "attachment": [],
    "comment": {
      "comments": [
        {
          "id": "30000",
          "author": {
            "displayName": "Priya (Product Owner)"
          },
          "body": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Clarification from refinement: a duplicate favourite is a conflict, so the API must answer "
                  },
                  {
                    "type": "text",
                    "text": "409 Conflict",
                    "marks": [
                      {
                        "type": "strong"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " (not 422 as in the technical notes). The web shop can keep its current message for duplicates."
                  }
                ]
              }
            ]
          },
          "created": "2026-09-28T11:20:41.685Z"
        }
      ],
      "total": 1
    },
    "customfield_10035": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-1: A signed-in customer adds a product to favourites with POST /favorites; the API responds 201 with the favourite (its id and the product id)."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-2: Adding a product that is already a favourite is rejected and the list still contains it once."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-3: GET /favorites lists the customer's own favourites only; another customer's favourites are never included."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-4: Every favourites endpoint responds 401 without a valid token."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-5: On the web shop, a signed-in customer who clicks \"Add to favourites\" on a product page sees \"Product added to your favorites list.\" and the product then appears on the \"Favorites\" page of their account."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-6: DELETE /favorites/{favoriteId} removes the favourite (204) and it no longer appears in GET /favorites."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
