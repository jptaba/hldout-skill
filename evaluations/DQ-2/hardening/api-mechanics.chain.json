{
  "vars": { "name": "qa-dq2-probe-${uid}" },
  "steps": [
    { "name": "G1 create user with {userName,password}", "method": "POST", "path": "Account/v1/User", "json": { "userName": "${name}", "password": "${env:DQ_USER_PASSWORD}" }, "save": { "uid2": "userID" }, "show": ["userID", "username", "books"] },
    { "name": "token", "method": "POST", "path": "Account/v1/GenerateToken", "json": { "userName": "${name}", "password": "${env:DQ_USER_PASSWORD}" }, "save": { "tok": "token" }, "show": ["status", "result", "expires"] },
    { "name": "add two books", "method": "POST", "path": "BookStore/v1/Books", "headers": { "Authorization": "Bearer ${tok}" }, "json": { "userId": "${uid2}", "collectionOfIsbns": [ { "isbn": "9781449325862" }, { "isbn": "9781593277574" } ] } },
    { "name": "read user", "method": "GET", "path": "Account/v1/User/${uid2}", "headers": { "Authorization": "Bearer ${tok}" }, "show": ["books.length", "userId", "username"] },
    { "name": "delete one book", "method": "DELETE", "path": "BookStore/v1/Book", "headers": { "Authorization": "Bearer ${tok}" }, "json": { "isbn": "9781449325862", "userId": "${uid2}" } },
    { "name": "read user again", "method": "GET", "path": "Account/v1/User/${uid2}", "headers": { "Authorization": "Bearer ${tok}" }, "show": ["books.length"] },
    { "name": "cleanup: delete user", "method": "DELETE", "path": "Account/v1/User/${uid2}", "headers": { "Authorization": "Bearer ${tok}" } }
  ]
}
