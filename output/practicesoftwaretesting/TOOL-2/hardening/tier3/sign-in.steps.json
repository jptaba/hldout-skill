[
  { "do": "goto", "url": "auth/login" },
  { "do": "wait", "target": "getByTestId('email')" },
  { "do": "fill", "target": "getByTestId('email')", "value": "${var:email}" },
  { "do": "fill", "target": "getByTestId('password')", "value": "${env:PST_CUSTOMER_PASSWORD}" },
  { "do": "click", "target": "getByTestId('login-submit')" },
  { "do": "wait", "target": "url:/account" }
]
