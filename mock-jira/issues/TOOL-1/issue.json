  "fields": {
    "summary": "Catalogue search, sorting and category filter",
    "issuetype": {
      "name": "Story"
    },
    "status": {
      "name": "Ready for QA"
    },
    "priority": {
      "name": "High"
    },
    "labels": [
      "heldout-fail"
    ],
    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "As a shopper I want to search, sort and filter the tool catalogue so that I find the right tool quickly. The web shop and the public catalogue API (used by our mobile app) must behave the same way."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Catalogue API: "
            },
            {
              "type": "text",
              "text": "GET /products",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " (list, "
            },
            {
              "type": "text",
              "text": "sort",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "text",
              "text": "by_category",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " parameters, paginated) and "
            },
            {
              "type": "text",
              "text": "GET /products/search?q=<term>",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " (search). Both return "
            },
            {
              "type": "text",
              "text": "{ \"current_page\", \"data\": [products], \"per_page\", \"total\", \"last_page\" }",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Acceptance Criteria"
            }
          ]
        },
        {
          "type": "orderedList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Searching the web shop for a term shows only products whose name contains the term, and a caption \"Searched for: <term>\"."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "GET /products/search?q=<term> returns 200 with only products whose name contains the term, regardless of letter case (searching \"PLIERS\" finds the same products as \"pliers\")."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "A search without matches shows \"There are no products found.\" on the web shop, and the API returns 200 with an empty data list and total 0."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Choosing \"Price (Low - High)\" on the web shop lists the products by ascending price; GET /products?sort=price,asc returns the products in ascending price order."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Filtering the web shop by the category \"Hammer\" shows only hammers; GET /products?by_category=<id of Hammer> returns only products in that category."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Results are paginated with 12 products per page (per_page 12) on the web shop and in the API."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "An empty search (no term) returns all products, so the mobile app can reuse the search endpoint for its \"All tools\" screen."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Notes"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Category ids come from GET /categories/tree."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Out of scope: product detail pages, brands filter."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
