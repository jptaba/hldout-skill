      "training",
      "ui",
      "heldout-pass"
    ],
    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Context"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The practice portal is a catalogue of small interactive pages that our support staff use for training. This story defines how the sign-in flow and the most-used widgets behave. Exact copy is in "
            },
            {
              "type": "text",
              "text": "ux-copy.md",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Acceptance criteria"
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Secure area"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-1",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": On the Login page ("
                    },
                    {
                      "type": "text",
                      "text": "/login",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "), signing in with the training account from "
                    },
                    {
                      "type": "text",
                      "text": "test-accounts.csv",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " opens the Secure Area ("
                    },
                    {
                      "type": "text",
                      "text": "/secure",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "), with the heading \"Secure Area\" and the message \"You logged into a secure area!\"."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-2",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": An unknown username shows \"Your username is invalid!\"; a known username with a wrong password shows \"Your password is invalid!\". In both cases the user stays on the Login page."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-3",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": Logging out returns to the Login page with \"You logged out of the secure area!\". Opening "
                    },
                    {
                      "type": "text",
                      "text": "/secure",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " while signed out shows the Login page with \"You must login to view the secure area!\"."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Widgets"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-4",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": On the Checkboxes page ("
                    },
                    {
                      "type": "text",
                      "text": "/checkboxes",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "), checkbox 1 is initially unchecked and checkbox 2 is initially checked. Clicking a checkbox toggles it."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-5",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": On the Dropdown page ("
                    },
                    {
                      "type": "text",
                      "text": "/dropdown",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "), the options are \"Please select an option\" (preselected and not selectable), \"Option 1\" and \"Option 2\". Choosing \"Option 2\" makes it the selected option."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-6",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": On Dynamic Loading example 2 ("
                    },
                    {
                      "type": "text",
                      "text": "/dynamic_loading/2",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "), after pressing \"Start\" the text \"Hello World!\" is rendered within 10 seconds."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-7",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": On the JavaScript Alerts page ("
                    },
                    {
                      "type": "text",
                      "text": "/javascript_alerts",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "), accepting the JS Alert shows \"You successfully clicked an alert\". Dismissing the JS Confirm shows \"You clicked: Cancel\". Entering text in the JS Prompt and accepting it shows \"You entered: <text>\"."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-8",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": On the Data Tables page ("
                    },
                    {
                      "type": "text",
                      "text": "/tables",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "), clicking the \"Last Name\" header of the first table once sorts its rows by last name, ascending."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-9",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": On Add/Remove Elements ("
                    },
                    {
                      "type": "text",
                      "text": "/add_remove_elements/",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "), each press of \"Add Element\" adds one \"Delete\" button. Each press of a \"Delete\" button removes that button."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC-10",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": On Key Presses ("
                    },
                    {
                      "type": "text",
                      "text": "/key_presses",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "), pressing a key while the input is focused shows \"You entered: <KEY>\" (for example "
                    },
                    {
                      "type": "text",
                      "text": "TAB",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " for the Tab key, "
                    },
                    {
                      "type": "text",
                      "text": "A",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " for A)."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
