                  {
                    "type": "text",
                    "text": "Clarification from refinement: a duplicate favourite is a conflict, so the API must answer "
                  },
                  {
                    "type": "text",
                    "text": "409 Conflict",
                    "marks": [
                      {
                        "type": "strong"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " (not 422 as in the technical notes). The web shop can keep its current message for duplicates."
                  }
                ]
              }
            ]
          },
