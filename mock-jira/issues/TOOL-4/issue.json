          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Signed-in customers can keep a personal list of favourite products, from the product page (web shop) and through the API (mobile app)."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Technical notes:",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "type": "text",
              "text": " endpoints "
            },
            {
              "type": "text",
              "text": "POST /favorites",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " (body "
            },
            {
              "type": "text",
              "text": "{\"product_id\"}",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": "), "
            },
            {
              "type": "text",
              "text": "GET /favorites",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "text",
              "text": "DELETE /favorites/{favoriteId}",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": "; all require "
            },
            {
              "type": "text",
              "text": "Authorization: Bearer <token>",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " from "
            },
            {
              "type": "text",
              "text": "POST /users/login",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": ". Duplicate favourites are rejected with 422."
            }
          ]
        }
      ]
    },
