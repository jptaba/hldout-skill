{
  "id": "10002",
  "key": "TOOL-2",
  "self": "https://your-domain.atlassian.net/rest/api/3/issue/TOOL-2",
  "fields": {
    "summary": "Customer registration, sign-in and account protection",
    "issuetype": {
      "name": "Story"
    },
    "status": {
      "name": "Ready for QA"
    },
    "priority": {
      "name": "High"
    },
    "labels": [
      "heldout-fail"
    ],
    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "As a customer I want to register and sign in, and I want my account protected against password guessing."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Identity API: "
            },
            {
              "type": "text",
              "text": "POST /users/register",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "text",
              "text": "POST /users/login",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " (returns "
            },
            {
              "type": "text",
              "text": "{ \"access_token\", \"token_type\", \"expires_in\" }",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": "), "
            },
            {
              "type": "text",
              "text": "GET /users/me",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "text",
              "text": "GET /users/logout",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " (both need "
            },
            {
              "type": "text",
              "text": "Authorization: Bearer <access_token>",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": "). Web shop sign-in page: \"Sign in\" in the navigation."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Acceptance criteria"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Scenario: Registration creates the customer without echoing the password"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "Given a new customer with a unique e-mail address"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "When their details are posted to POST /users/register"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "Then the API responds 201 with the customer's details and an id"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "And the response does not contain the password"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Scenario: A registered e-mail address cannot register twice"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "Given a customer already registered with an e-mail address"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "When the same e-mail address is registered again"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "Then the API responds 409 with the message \"A customer with this email address already exists.\""
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Scenario: Weak passwords are rejected with every broken rule listed"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "Given a new customer whose password is \"abc\""
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "When they register"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "Then the API responds 422 and the password errors state all four rules: at least 8 characters, upper and lower case letters, a symbol, a number"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Scenario: Signing in on the web shop"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "Given a registered customer on the web shop's sign-in page"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "When they sign in with their e-mail address and password"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "Then they land on the \"My account\" page"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "And the navigation shows their first and last name"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Scenario: A wrong password is refused"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "Given a registered customer"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "When they sign in with a wrong password"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "Then POST /users/login responds 401"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "And the web shop shows \"Invalid email or password\""
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Scenario: The account locks after five failed attempts"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "Given a registered customer"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "When five sign-in attempts with a wrong password are made"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "Then attempts one to five respond 401"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "And the sixth attempt, even with the correct password, responds 423 with a message that the account is locked"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Scenario: Signing out invalidates the token"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "Given a signed-in customer with an access token"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "When they sign out with GET /users/logout"
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "Then GET /users/me with the same token responds 401"
            }
          ]
        }
      ]
    },
