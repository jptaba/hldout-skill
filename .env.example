# Copy to .env (git-ignored). Values here override heldout.config.json.

# --- Application under test ---
AUT_BASE_URL=
# Secrets referenced from evaluations/<KEY>/test-data.json as ${env:NAME}
# AUT_USER_PASSWORD=

# --- Jira ---
# mock = file-backed simulator in ./mock-jira (no subscription needed); cloud = real Jira Cloud REST v3
JIRA_MODE=mock
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Demo (DEMO-101) secret referenced from evaluations/DEMO-101/test-data.json
DEMO_SHOPPER_PASSWORD=

# DEMO-202 staff password referenced from evaluations/DEMO-202/test-data.json
SHADY_STAFF_PASSWORD=

PARTNER_PASSWORD=
TRAINEE_PASSWORD=

# DEMO-707 (conduit): password used for the throwaway qa* accounts tests register
CONDUIT_USER_PASSWORD=

# Toolshop (TOOL-*): password for throwaway customers (8+ chars, upper+lower, symbol, number)
TOOLSHOP_CUSTOMER_PASSWORD=

JS_USER_PASSWORD=
AE_USER_PASSWORD=
