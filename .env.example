# Copy to .env (git-ignored). Values here override heldout.config.json; real environment variables (CI) override .env.

# --- Application under test ---
AUT_BASE_URL=

# --- Test accounts and other secrets ---
# Referenced as ${env:NAME} from evaluations/<KEY>/test-data.json and the profile's accounts (heldout accounts …).
# Fill them without showing them: npm run heldout -- secret NAME --generate (accounts the tests create)
#                                 npm run heldout -- secret NAME --ask      (an existing account's password, hidden prompt)
# APP_USER_PASSWORD=

# --- HashiCorp Vault (optional; secrets referenced as ${vault:secret/qa/app#password}) ---
# Token: `vault login` once (picked up from ~/.vault-token), or VAULT_TOKEN, or AppRole (VAULT_ROLE_ID + VAULT_SECRET_ID).
# VAULT_ADDR=https://vault.example.com
# VAULT_NAMESPACE=
# VAULT_TOKEN=
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=

# --- Jira ---
# mock = file-backed simulator in ./mock-jira (no subscription needed); cloud = real Jira Cloud REST v3
JIRA_MODE=mock
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
