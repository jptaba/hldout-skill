# Copy to .env (git-ignored). Values here override heldout.config.json.
# Set a password without showing it: npm run heldout -- secret NAME --generate (or --ask for one you already have).

# --- Jira ---
# mock = file-backed simulator in ./mock-jira (no subscription needed); cloud = real Jira Cloud REST v3
JIRA_MODE=mock
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Sample evaluations (evaluations/<KEY>) ---
# DQ-2 (DemoQA): existing test accounts, two with passwords here and two entirely in HashiCorp Vault.
# The accounts the sample used no longer exist: add your own with npm run heldout -- accounts --add-existing …
APP_PASSWORD_1=
APP_PASSWORD_2=
VAULT_ADDR=
# CL-3 (Contact List), TOOL-4 (Toolshop), JS-2 (Juice Shop): the password of the accounts the tests create
CL_USER_PASSWORD=
TS_USER_PASSWORD=
JS_USER_PASSWORD=
